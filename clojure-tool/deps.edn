{:paths ["src" "src-core"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        ;; The same resolver the project itself uses, so the dump can never disagree
        ;; with what `clojure -M`/`-X` actually puts on the classpath.
        org.clojure/tools.deps {:mvn/version "0.31.1642"}
        org.clojure/data.json {:mvn/version "2.5.2"}}
 ;; For a development `-Ttools install` from :local/root (or git), so unqualified
 ;; calls behave like the documented alias flow. The Maven flow does not read this:
 ;; tools.deps has no usage lookup for :mvn coordinates (coord-usage :mvn is TBD
 ;; upstream), which is why docs/clojure.md documents a deps.edn alias carrying
 ;; :ns-default itself instead.
 :tools/usage {:ns-default exoego.uika}
 :aliases
 {:build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}
  ;; target/core-classes holds the vendored JfrEvidence compiled by
  ;; `clojure -T:build javac` (the Makefile's clojure-test runs it first); the
  ;; published jar carries the same class at its root.
  :test {:extra-paths ["test" "target/core-classes"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  ;; Cloverage drives clojure.test itself, so it replaces the test-runner rather than
  ;; wrapping it, and needs the same javac'd JfrEvidence on the path that :test does.
  :coverage {:extra-paths ["test" "target/core-classes"]
             :extra-deps {cloverage/cloverage {:mvn/version "1.2.4"}}
             :main-opts ["-m" "cloverage.coverage"
                         "-p" "src" "-p" "src-core" "-s" "test"
                         "--lcov" "--no-html"]}}}
