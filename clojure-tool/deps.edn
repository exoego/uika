{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        ;; The same resolver the project itself uses, so the dump can never disagree
        ;; with what `clojure -M`/`-X` actually puts on the classpath.
        org.clojure/tools.deps {:mvn/version "0.31.1642"}
        org.clojure/data.json {:mvn/version "2.5.2"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
