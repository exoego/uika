{:paths ["src" "src-core"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        ;; The same resolver the project itself uses, so the dump can never disagree
        ;; with what `clojure -M`/`-X` actually puts on the classpath.
        org.clojure/tools.deps {:mvn/version "0.31.1642"}
        org.clojure/data.json {:mvn/version "2.5.2"}}
 ;; For a `-Ttools` install from git or :local/root. The Maven flow does not read
 ;; this: tools.deps has no usage lookup for :mvn coordinates (coord-usage :mvn is
 ;; TBD upstream), which is why docs/clojure.md documents a deps.edn alias carrying
 ;; :ns-default itself instead.
 :tools/usage {:ns-default exoego.uika}
 :aliases
 {:build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
