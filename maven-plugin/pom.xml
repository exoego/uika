<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>net.exoego.uika</groupId>
  <artifactId>uika-maven-plugin</artifactId>
  <!-- CI-friendly version: CI passes -Drevision=x.y.z, flatten-maven-plugin
       resolves it in the deployed POM (no versions:set rewrite needed). -->
  <version>${revision}</version>
  <packaging>maven-plugin</packaging>

  <name>uika-maven-plugin</name>
  <description>Maven plugin for writing uika resolved classpath dumps and running upgrade checks</description>
  <url>https://github.com/exoego/uika</url>

  <licenses>
    <license>
      <name>Apache License 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>exoego</id>
      <name>TATSUNO Yasuhiro</name>
      <url>https://github.com/exoego</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/exoego/uika.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/exoego/uika.git</developerConnection>
    <url>https://github.com/exoego/uika</url>
  </scm>

  <distributionManagement>
    <!-- Local staging directory; JReleaser signs and uploads it to Maven Central. -->
    <repository>
      <id>local-staging</id>
      <name>Local staging</name>
      <url>file:${project.build.directory}/staging-deploy</url>
    </repository>
  </distributionManagement>

  <properties>
    <revision>0.0.0-dev</revision>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <mavenPluginTools.version>3.15.2</mavenPluginTools.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>3.9.16</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>3.9.16</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>${mavenPluginTools.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <!-- Artifact resolution for the uika-cli binary; the runtime uses Maven's own resolver. -->
      <groupId>org.apache.maven.resolver</groupId>
      <artifactId>maven-resolver-api</artifactId>
      <version>2.0.22</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <!-- Kept at the same version the Gradle plugin's test suite uses. -->
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Pinned like the Gradle build pins it, so a surefire or JUnit bump cannot
           break provider selection into a silent zero-test run. -->
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- Pinned for reproducibility across Maven versions (3.9.16's own binding is
             already 3.5.4). failIfNoTests, because this module's only test is the
             class-file floor guard and a provider mismatch silently running zero tests
             would green a build the guard exists to fail. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
        <configuration>
          <failIfNoTests>true</failIfNoTests>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>1.8.0</version>
        <configuration>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>add-shared-jvm-core</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../jvm-plugin-core/src/main/java</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>add-shared-jvm-core-tests</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../jvm-plugin-core/src/test/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-plugin-plugin</artifactId>
        <version>${mavenPluginTools.version}</version>
        <configuration>
          <goalPrefix>uika</goalPrefix>
        </configuration>
        <executions>
          <execution>
            <id>default-descriptor</id>
            <goals>
              <goal>descriptor</goal>
            </goals>
          </execution>
          <execution>
            <id>help-goal</id>
            <goals>
              <goal>helpmojo</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-invoker-plugin</artifactId>
        <version>3.10.1</version>
        <configuration>
          <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
          <localRepositoryPath>${project.build.directory}/it-repo</localRepositoryPath>
          <postBuildHookScript>verify</postBuildHookScript>
          <streamLogs>true</streamLogs>
        </configuration>
        <executions>
          <execution>
            <id>integration-test</id>
            <goals>
              <goal>install</goal>
              <goal>run</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Opt-in, so a plain `mvn verify` stays uninstrumented. Two agents because the two
         halves are tested in different JVMs: surefire covers jvm-plugin-core here, while the
         mojos only ever run inside the Maven the invoker forks, which <mavenOpts> reaches. -->
    <profile>
      <id>coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>0.8.14</version>
            <executions>
              <execution>
                <id>prepare-agent</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
                <configuration>
                  <!-- Class-name patterns, and only on the agents: the report goals read
                       <includes> as class-FILE patterns, so the same value empties them. -->
                  <includes>
                    <include>net.exoego.uika.*</include>
                  </includes>
                </configuration>
              </execution>
              <execution>
                <id>prepare-agent-integration</id>
                <goals>
                  <goal>prepare-agent-integration</goal>
                </goals>
                <configuration>
                  <propertyName>uikaItArgLine</propertyName>
                  <includes>
                    <include>net.exoego.uika.*</include>
                  </includes>
                </configuration>
              </execution>
              <execution>
                <id>report</id>
                <phase>verify</phase>
                <goals>
                  <goal>report</goal>
                </goals>
              </execution>
              <execution>
                <id>report-integration</id>
                <phase>verify</phase>
                <goals>
                  <goal>report-integration</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- Merges into the base declaration; the version comes from there. -->
            <artifactId>maven-invoker-plugin</artifactId>
            <configuration>
              <mavenOpts>${uikaItArgLine}</mavenOpts>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Maven Central requires sources and javadoc jars; keep them out of
         regular builds (javadoc slows down invoker runs). -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <!-- Central requires the javadoc jar to exist, not to have content.
               The real docs were 143 KB published, most of it the jQuery and
               stylesheet boilerplate the standard doclet emits, and the Maven
               Central quota is shared across the whole net.exoego namespace.
               maven-javadoc-plugin has no "emit an empty jar" mode, so skip it
               and attach a jar built from a directory that is never created.
               maven-jar-plugin warns "JAR will be empty" and emits the manifest
               alone, which is what Central wants. Pointing at a real directory
               would publish whatever a dirty tree left in it. Readers use the
               sources jar. See PUBLISHING.md. -->
          <plugin>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <configuration>
              <skip>true</skip>
            </configuration>
          </plugin>
          <plugin>
            <artifactId>maven-jar-plugin</artifactId>
            <version>3.5.1</version>
            <executions>
              <execution>
                <id>attach-empty-javadoc</id>
                <phase>package</phase>
                <goals>
                  <goal>jar</goal>
                </goals>
                <configuration>
                  <classifier>javadoc</classifier>
                  <classesDirectory>${project.build.directory}/no-such-javadoc-dir</classesDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
