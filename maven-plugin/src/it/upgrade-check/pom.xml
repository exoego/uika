<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>net.exoego.uika.it</groupId>
  <artifactId>dummy-upgrade-check</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- The command-line form of excludeFiles, exercised as a project property rather than
         a -D: invoker.goals is a List parameter, so Maven splits its value on commas and a
         comma-carrying -D cannot survive it. The mojo reads ${uika.excludeFiles} either
         way, so the binding under test is the same. The empty middle entry is deliberate;
         a CI-assembled list ends up with doubled commas and they must drop rather than
         reach clap as empty paths. -->
    <uika.excludeFiles>cli-exclude.toml,,second-exclude.toml</uika.excludeFiles>
  </properties>

  <!-- Stub repository written by setup.groovy. -->
  <repositories>
    <repository>
      <id>uika-stub</id>
      <url>${project.baseUri}repo</url>
    </repository>
  </repositories>

  <build>
    <plugins>
      <plugin>
        <groupId>net.exoego.uika</groupId>
        <artifactId>uika-maven-plugin</artifactId>
        <version>@project.version@</version>
        <!-- Declarative config in the POM (not a -D property): must reach the CLI fail-on flag
             and the exclude file list. -->
        <configuration>
          <failOn>reachable</failOn>
          <!-- Pinned below the build JVM so no clamping applies; must reach the CLI. -->
          <jdkRelease>11</jdkRelease>
          <excludeFiles>
            <excludeFile>${project.basedir}/uika-exclude.toml</excludeFile>
          </excludeFiles>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
