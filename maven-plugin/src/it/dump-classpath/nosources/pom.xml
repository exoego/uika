  <!-- A jar module with no sources, so nothing ever creates target/classes. It is still a
       module: it can gain sources tomorrow, and this goal binds to no lifecycle phase, so
       an unbuilt tree looks exactly like this for EVERY module. That is why the aggregator
       is skipped on packaging rather than on a missing output directory, and this module is
       what holds that line. -->
  <artifactId>dummy-maven-nosources</artifactId>
  <packaging>jar</packaging>
</project>
