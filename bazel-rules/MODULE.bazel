# The version stays at the placeholder in git and is stamped at release, the same rule
# cli/Cargo.toml follows. private/version.bzl carries the same value and is what the
# uika-cli download defaults to, so the two are stamped together.
module(
    name = "uika",
    version = "0.0.0-dev",
    compatibility_level = 1,
    # Verified on 7.6, 8.4 and 9.2. The floor is bzlmod being the default, which is what
    # makes bazel_dep the whole installation story.
    bazel_compatibility = [">=7.0.0"],
)

bazel_dep(name = "rules_java", version = "9.1.0")

# Declared here so a build that only loads the rules gets a working uika_upgrade_check.
# The repository is lazy at module resolution, but the binary rides in every check
# target's data, so BUILDING one (a //... sweep included) fetches it; only a build that
# never builds a check target downloads nothing.
uika = use_extension("//:extensions.bzl", "uika")
use_repo(uika, "uika_cli")
