load("@uika//:defs.bzl", "uika")

# The version bump under test. In a real build this is a maven_install.json edit; here it
# swaps which vendored jar //app depends on, keeping the module LABEL identical across the
# two dumps -- upgrade-check pairs modules by name, and a renamed module would silently
# drop it to merged mode.
config_setting(
    name = "guava_23",
    values = {"define": "guava=23"},
)

UIKA_TARGETS = [
    "//app",
    "//lib",
]

# :uika_dump, :uika_baseline_dump and :uika_check, the shape the docs show.
uika(
    name = "uika",
    targets = UIKA_TARGETS,
)

# The no-targets shape the //... sweep pairs with, where the release can only come from the
# Java toolchain. Its own code path, since there is no module to read a javacopt from.
uika(name = "no_targets")

# A stated runtime. The one value has to reach both the dumps and the check, which is what
# two separate macros used to let drift apart.
uika(
    name = "runtime17",
    jdk_release = 17,
    targets = UIKA_TARGETS,
)

# The off switch. 0 must reach the CLI as no --jdk-release at all, which only works while
# the default stays distinguishable from an explicit 0. The dumps keep the derived release,
# so a JDK move is still detected.
uika(
    name = "layer_off",
    jdk_release = 0,
    targets = UIKA_TARGETS,
)

# Per-module checking is the default and the expensive one. The attribute has to reach the
# CLI, and --noMergedClasspath has to be able to take it back off: a boolean is the one
# shape where "a run-time flag wins over the attribute" needs a pair.
uika(
    name = "merged",
    merged_classpath = True,
    targets = UIKA_TARGETS,
)

# exclude_files rides one comma-joined -D property, unlike every sibling integration's
# repeated flag, so its split is code only this ruleset has. The run-time --excludeFile
# APPENDS to the attribute rather than replacing it, which is the one place the two
# disagree with the rest of the option surface.
uika(
    name = "excludes",
    exclude_files = [
        "excludes-a.toml",
        "excludes-b.toml",
    ],
    targets = UIKA_TARGETS,
)
