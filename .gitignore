# run.sh writes these, so tracking them would just drift. uika-draft.toml is CLI
# output, rewritten twice per run (placeholder first, then the drafted rules).
lein-plugin/it/test-project/uika-exclude.toml
lein-plugin/it/test-project/loads.log
lein-plugin/it/test-project/uika-draft.toml
lein-plugin/it/test-project/jfr-evidence/
# Bazel convenience symlinks, if anyone runs bazel inside the ruleset itself. The
# integration test runs in a temp copy and never creates them here.
bazel-rules/bazel-*
# Written by `make bazel-unit-test`. Not committed: lockFileVersion tracks the Bazel
# that wrote it while MODULE.bazel advertises >=7.0.0, and the default
# --lockfile_mode=update would let a test run dirty a tracked file.
bazel-rules/MODULE.bazel.lock
sbt-plugin/.idea/
*.iml
.mise.local.toml
.DS_Store

# Local tool logs
logs/

# JVM heap dumps from crashed test runs
*.hprof
