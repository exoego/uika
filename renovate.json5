{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Modern default set. Includes config:recommended, the dependency dashboard,
  // and helpers:pinGitHubActionDigests so new Actions keep the SHA-pin +
  // "# vX.Y.Z" comment style this repo already uses.
  extends: [
    "config:best-practices",
    ":semanticCommitScope(deps)",
  ],
  timezone: "Asia/Tokyo",
  labels: ["dependencies"],
  // Let a release settle for a week before proposing it. Catches the
  // yanked-or-hotfixed-within-days case without any manual triage.
  minimumReleaseAge: "7 days",
  // Keep the PR stream calm for a small OSS project.
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
  // Integration-test fixtures pin versions on purpose. Bumping them is noise
  // and can break scripted or invoker tests, so leave them out of the scan.
  ignorePaths: [
    "**/node_modules/**",
    "**/src/it/**",
    "**/src/sbt-test/**",
  ],
  // Refresh Cargo.lock on a schedule even when no manifest range changes.
  lockFileMaintenance: {
    enabled: true,
  },
  packageRules: [
    {
      matchManagers: ["github-actions"],
      groupName: "github-actions",
    },
    {
      matchManagers: ["cargo"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "rust crates (non-major)",
    },
    // gradle, sbt, maven, java and other toolchain pins in .mise.toml.
    {
      matchManagers: ["mise"],
      groupName: "build toolchain (mise)",
    },
    // sbt 1.x itself runs on Scala 2.12, so an sbt 1.x plugin can only be
    // built on 2.12. There is no scripted-sbt_2.13 or scripted-sbt_3 to
    // resolve against, so any bump here fails at update time. This pin is
    // part of the sbt version, not a dependency we get to choose.
    {
      matchManagers: ["sbt"],
      matchDepNames: ["scala"],
      enabled: false,
    },
    // Stay on sbt 1.x. An sbt 2.0 build publishes the plugin as
    // sbt-uika_sbt2_3 (sbt binary version, then Scala 3), while every sbt 1.x
    // consumer resolves sbt-uika_2.12_1.0. The two are unrelated coordinates
    // with no fallback, so moving to 2.0 silently drops all current users.
    // Supporting both means cross-publishing, which doubles the Maven Central
    // footprint we just halved, and porting off the Classpath type sbt 2
    // changed to HashedVirtualFileRef. Revisit deliberately, not via a bump.
    // build.properties decides what actually builds and publishes. The mise
    // pin only picks the launcher, which reads build.properties and boots
    // whatever it says, so the two are constrained for different reasons.
    {
      matchDepNames: ["sbt", "sbt/sbt"],
      allowedVersions: "<2",
    },
  ],
}
