{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices",
    ":semanticCommitScope(deps)",
  ],
  timezone: "Asia/Tokyo",
  labels: ["dependencies"],
  minimumReleaseAge: "7 days",
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
  // Integration-test fixtures pin versions on purpose. Bumping them is noise
  // and can break scripted or invoker tests, so leave them out of the scan.
  ignorePaths: [
    "**/node_modules/**",
    "**/src/it/**",
    "**/src/sbt-test/**",
    // The lein fixture has no src/ segment, and its project.clj is a file the
    // leiningen manager matches by name anywhere in the tree.
    "lein-plugin/it/**",
  ],
  lockFileMaintenance: {
    enabled: true,
  },
  packageRules: [
    {
      matchManagers: ["github-actions"],
      groupName: "github-actions",
    },
    {
      matchManagers: ["cargo"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "rust crates (non-major)",
    },
    // gradle, sbt, maven, java and other toolchain pins in .mise.toml.
    {
      matchManagers: ["mise"],
      groupName: "build toolchain (mise)",
    },
    // sbt 1.x itself runs on Scala 2.12, so an sbt 1.x plugin can only be
    // built on 2.12.
    {
      matchManagers: ["sbt"],
      matchDepNames: ["scala"],
      enabled: false,
    },
    // Stay on sbt 1.x. An sbt 2.0 build publishes the plugin as
    // sbt-uika_sbt2_3 (sbt binary version, then Scala 3), while every sbt 1.x
    // consumer resolves sbt-uika_2.12_1.0.
    // "sbt/sbt" conda, asdf plugin
    // "github:sbt/sbt" — GitHub release
    {
      matchDepNames: ["sbt/sbt", "github:sbt/sbt"],
      allowedVersions: "<2",
    },
  ],
}
