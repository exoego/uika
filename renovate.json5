{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices",
    ":semanticCommitScope(deps)",
  ],
  timezone: "Asia/Tokyo",
  labels: ["dependencies"],
  minimumReleaseAge: "7 days",
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
  // Integration-test fixtures pin versions on purpose. Bumping them is noise
  // and can break scripted or invoker tests, so leave them out of the scan.
  ignorePaths: [
    "**/node_modules/**",
    "**/src/it/**",
    "**/src/sbt-test/**",
    // The lein fixture has no src/ segment, and its project.clj is a file the
    // leiningen manager matches by name anywhere in the tree.
    "lein-plugin/it/**",
  ],
  lockFileMaintenance: {
    enabled: true,
  },
  // The mise manager skips a tool written as a full asdf plugin path
  // (asdf:owner/plugin), which is how JReleaser has to be pinned. Nothing else
  // in .mise.toml needs this, so the annotation is opt-in and the manager only
  // sees the lines that carry one.
  customManagers: [
    {
      customType: "regex",
      description: "mise tools the mise manager drops, annotated in .mise.toml",
      managerFilePatterns: ["/^\\.mise\\.toml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s+\\S+ = \"(?<currentValue>[^\"]+)\"",
      ],
    },
  ],
  packageRules: [
    {
      matchManagers: ["github-actions"],
      groupName: "github-actions",
    },
    {
      matchManagers: ["cargo"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "rust crates (non-major)",
    },
    // gradle, sbt, maven, java and other toolchain pins in .mise.toml. The
    // custom manager reads that same file, so its updates belong in the same
    // group rather than in a PR of their own.
    {
      matchManagers: ["mise", "custom.regex"],
      groupName: "build toolchain (mise)",
    },
    // sbt 1.x itself runs on Scala 2.12, so an sbt 1.x plugin can only be
    // built on 2.12.
    {
      matchManagers: ["sbt"],
      matchDepNames: ["scala"],
      enabled: false,
    },
    // Stay on sbt 1.x. An sbt 2.0 build publishes the plugin as
    // sbt-uika_sbt2_3 (sbt binary version, then Scala 3), while every sbt 1.x
    // consumer resolves sbt-uika_2.12_1.0.
    // "sbt/sbt" conda, asdf plugin
    // "github:sbt/sbt" — GitHub release
    {
      matchDepNames: ["sbt/sbt", "github:sbt/sbt"],
      allowedVersions: "<2",
    },
    // OpenRewrite releases after these resolve only from an authenticated
    // repository, so a bump breaks make rewrite-check. The pin rationale lives
    // in tools/openrewrite/rewrite.gradle.
    {
      matchDepNames: [
        "org.openrewrite:plugin",
        "org.openrewrite.recipe:rewrite-migrate-java",
        "org.openrewrite.recipe:rewrite-static-analysis",
      ],
      enabled: false,
    },
  ],
}
